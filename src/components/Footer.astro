---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__brand display">Hellsoft<span>Games</span></p>
    <p class="site-footer__copy muted">
      © {year} Erik Hellman. Games built in the open. Source on
      <a href="https://github.com/ErikHellman" rel="noopener">GitHub</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-5);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .site-footer__brand {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .site-footer__brand span {
    color: var(--muted);
    font-weight: 500;
    margin-left: 0.3em;
  }
  .site-footer__copy {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
