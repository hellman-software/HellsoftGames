---
import { ADSENSE_CLIENT, AD_UNITS, ADS_ENABLED } from '../lib/ads';

/**
 * Ad unit. Renders an AdSense unit when the slot has a unit id in `lib/ads.ts`
 * and this is a production build; otherwise a dashed placeholder. Fixed dimensions per size so inserting a real
 * ad later causes no layout shift. A future ad script can find every slot via
 * `[data-ad-slot]` and read `data-ad-size` for the unit to request.
 */
interface Props {
  /** Unique id for this placement, e.g. "home-leaderboard". */
  id: string;
  size: 'leaderboard' | 'rectangle' | 'card';
  class?: string;
}
const { id, size, class: className } = Astro.props;
const dims = { leaderboard: '728x90|320x50', rectangle: '300x250', card: 'native' }[size];
const unit = AD_UNITS[id];
const live = ADS_ENABLED && Boolean(unit);
---

<aside
  class:list={['ad', `ad--${size}`, { 'ad--live': live }, className]}
  data-ad-slot={id}
  data-ad-size={dims}
  aria-label="Advertisement"
>
  {
    live ? (
      <>
        <ins
          class="adsbygoogle"
          data-ad-client={ADSENSE_CLIENT}
          data-ad-slot={unit}
          data-ad-format={size === 'leaderboard' ? 'horizontal' : 'auto'}
          data-full-width-responsive="false"
        />
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    ) : (
      <>
        <span class="ad__label">Ad</span>
        <slot />
      </>
    )
  }
</aside>

<style>
  .ad {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
    background: var(--bg-2);
    border: 2px dashed var(--muted);
    opacity: 0.85;
    overflow: hidden;
  }
  .ad--live {
    background: none;
    border: 0;
    opacity: 1;
  }
  .ad--live :global(ins.adsbygoogle) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ad__label {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    line-height: 1;
    text-transform: uppercase;
    padding: 4px 6px;
    color: var(--muted);
    background: var(--bg);
  }
  .ad--leaderboard {
    width: 100%;
    max-width: 320px;
    height: 50px;
  }
  @media (min-width: 768px) {
    .ad--leaderboard {
      max-width: 728px;
      height: 90px;
    }
  }
  .ad--rectangle {
    width: 300px;
    max-width: 100%;
    height: 250px;
  }
  .ad--card {
    width: 100%;
    min-height: 16rem;
    height: 100%;
  }
</style>
