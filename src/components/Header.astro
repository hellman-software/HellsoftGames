---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/url';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand display" href={withBase('/')} aria-label="Hellsoft Games home">
      <svg class="brand__mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <defs>
          <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--magenta)" />
            <stop offset="1" stop-color="var(--cyan)" />
          </linearGradient>
        </defs>
        <rect width="28" height="28" rx="8" fill="url(#brand-g)" />
        <path fill="var(--on-accent)" d="M8 6h4v6.5h4V6h4v16h-4v-6h-4v6H8z" />
      </svg>
      <span class="brand__text">Hellsoft<span class="brand__accent">Games</span></span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a class="site-nav__link" href={withBase('/') + '#games'}>Games</a>
      <a class="site-nav__link" href="https://github.com/ErikHellman" rel="noopener">GitHub</a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text);
    margin: 0;
    line-height: 1;
  }
  .brand:hover {
    color: var(--text);
  }
  .brand__mark {
    flex: none;
    filter: drop-shadow(0 4px 12px var(--glow));
  }
  .brand__accent {
    color: var(--muted);
    font-weight: 500;
    margin-left: 0.3em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-nav__link {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-2);
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    transition: color var(--fast) var(--ease), background var(--fast) var(--ease);
  }
  .site-nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  @media (max-width: 480px) {
    .site-nav__link:first-child {
      display: none;
    }
  }
</style>
