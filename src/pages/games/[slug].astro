---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import SupportIcon from '../../components/SupportIcon.astro';
import { getListedGames, formatDate, paragraphs, repoUrl } from '../../lib/games';
import { controlsOf, devicesOf } from '../../lib/support';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const games = await getListedGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { title, genre, blurb, description, status, playUrl, tech, tags, cover, logo, screenshots, pixelArt, sync } =
  game.data;
const repo = repoUrl(game);
const release = sync?.release ?? null;
const releaseDate = formatDate(release?.publishedAt);
const updated = formatDate(sync?.pushedAt);
const body = paragraphs(description || sync?.description || '');
const hero = cover ?? screenshots[0]?.src ?? null;
const gallery = screenshots.filter((s) => s.src !== hero);
const support = [
  { label: 'Controls', items: controlsOf(game) },
  { label: 'Devices', items: devicesOf(game) },
].filter((g) => g.items.length > 0);
---

<Base title={title} description={blurb} image={hero ? hero.src : undefined}>
  <article class="game">
    <div class="game__hero reveal">
      {
        hero ? (
          <Image
            src={hero}
            alt={screenshots[0]?.alt ?? `${title} screenshot`}
            width={1600}
            height={900}
            class:list={['game__hero-img', { pixelated: pixelArt }]}
            loading="eager"
          />
        ) : logo ? (
          <div class="game__logo-wrap">
            <Image src={logo} alt={`${title} logo`} width={360} height={360} class="game__logo" loading="eager" />
          </div>
        ) : (
          <div class="game__placeholder display">{title}</div>
        )
      }
      <div class="game__hero-overlay">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={withBase('/') + '#games'}>← All games</a>
        </nav>
        <div class="game__meta">
          <StatusBadge status={status} />
          <span class="label game__genre">{genre}</span>
        </div>
        <h1 class="game__title">{title}</h1>
        <p class="game__blurb">{blurb}</p>
        <div class="game__actions">
          <a class="btn" href={playUrl} target="_blank" rel="noopener">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            Play now
          </a>
          {
            repo && (
              <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener">
                Source
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="game__layout">
      <section class="game__about reveal" style="--i: 1" aria-labelledby="about-heading">
        <h2 id="about-heading">About</h2>
        {body.map((p) => <p>{p}</p>)}

        {
          gallery.length > 0 && (
            <section aria-labelledby="shots-heading" class="shots">
              <h2 id="shots-heading">Screenshots</h2>
              <ul class="gallery">
                {gallery.map((shot) => (
                  <li class="gallery__item">
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      width={800}
                      height={450}
                      class:list={['gallery__img', { pixelated: pixelArt }]}
                      loading="lazy"
                    />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </section>

      <aside class="game__facts panel reveal" style="--i: 2" aria-label="Game facts">
        <dl class="facts">
          <div class="facts__row">
            <dt class="label">Status</dt>
            <dd><StatusBadge status={status} /></dd>
          </div>
          {
            release && (
              <div class="facts__row">
                <dt class="label">Version</dt>
                <dd>
                  {release.tag}
                  {releaseDate && <span class="muted"> · {releaseDate}</span>}
                </dd>
              </div>
            )
          }
          {
            updated && (
              <div class="facts__row">
                <dt class="label">Updated</dt>
                <dd>{updated}</dd>
              </div>
            )
          }
          <div class="facts__row">
            <dt class="label">Platform</dt>
            <dd>Web browser</dd>
          </div>
          {support.map((group) => (
            <div class="facts__row">
              <dt class="label">{group.label}</dt>
              <dd>
                <ul class="support-list">
                  {group.items.map((item) => (
                    <li class:list={['support-list__item', { 'support-list__item--off': !item.supported }]}>
                      <span class="support-list__icon">
                        <SupportIcon type={item.type} crossed={!item.supported} />
                      </span>
                      <span>
                        <span class="support-list__label">{item.label}</span>
                        {item.note && <span class="support-list__note">{item.note}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
          <div class="facts__row">
            <dt class="label">Built with</dt>
            <dd>
              <ul class="chips">
                {tech.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </dd>
          </div>
          {
            tags.length > 0 && (
              <div class="facts__row">
                <dt class="label">Tags</dt>
                <dd>
                  <ul class="chips">
                    {tags.map((t) => (
                      <li class="chip chip--tag">#{t}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            repo && (
              <div class="facts__row">
                <dt class="label">Source</dt>
                <dd>
                  <a href={repo} rel="noopener">
                    {game.data.repo.owner}/{game.data.repo.name}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
        <a class="btn facts__play" href={playUrl} target="_blank" rel="noopener">
          <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          Play now
        </a>
      </aside>
    </div>

    <AdSlot id="game-bottom" size="rectangle" class="game__ad" />
  </article>
</Base>

<style>
  .game__hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-2);
    background: var(--bg-2);
    min-height: clamp(26rem, 60vh, 38rem);
    display: grid;
    margin-bottom: var(--space-5);
  }
  .game__hero-img,
  .game__logo-wrap,
  .game__placeholder {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .game__logo-wrap {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 50%, var(--glow), transparent 55%),
      radial-gradient(circle at 85% 15%, var(--glow-2), transparent 50%),
      var(--bg-2);
  }
  .game__logo {
    width: min(40%, 18rem);
    height: auto;
    margin-bottom: 10rem;
    filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.5));
  }
  .game__placeholder {
    display: grid;
    place-items: center;
    font-size: 2rem;
    color: var(--muted);
  }
  .game__hero-overlay {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: linear-gradient(
      to top,
      var(--media-fade) 0%,
      color-mix(in srgb, var(--media-fade) 82%, transparent) 38%,
      color-mix(in srgb, var(--media-fade) 35%, transparent) 65%,
      transparent 90%
    );
  }
  :global(:root[data-theme='light']) .game__hero-overlay {
    background: linear-gradient(to top, rgba(10, 10, 20, 0.92) 0%, rgba(10, 10, 20, 0.6) 45%, transparent 80%);
    color: #fff;
  }
  :global(:root[data-theme='light']) .game__hero-overlay .game__blurb,
  :global(:root[data-theme='light']) .game__hero-overlay .crumbs a {
    color: rgba(255, 255, 255, 0.82);
  }
  .crumbs {
    margin-bottom: auto;
  }
  .crumbs a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-2);
    padding: 0.4em 0.9em;
    border-radius: var(--radius-pill);
    background: rgba(10, 10, 18, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: color var(--fast) var(--ease), background var(--fast) var(--ease);
  }
  .crumbs a:hover {
    color: var(--text);
    background: rgba(10, 10, 18, 0.7);
  }
  .game__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .game__genre {
    color: var(--cyan);
  }
  .game__title {
    margin-bottom: var(--space-3);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.4);
  }
  .game__blurb {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text-2);
    max-width: 44rem;
    margin-bottom: var(--space-4);
  }
  .game__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .game__layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (max-width: 760px) {
    .game__layout {
      grid-template-columns: 1fr;
    }
  }
  .game__about p {
    max-width: 65ch;
    font-size: 1.05rem;
    color: var(--text-2);
  }
  .shots {
    margin-top: var(--space-5);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
  }
  .gallery__item {
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-1);
  }
  .gallery__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }
  .gallery__item:hover .gallery__img {
    transform: scale(1.04);
  }
  .game__facts {
    padding: var(--space-4);
    position: sticky;
    top: calc(var(--header-h) + var(--space-3));
  }
  .facts {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .facts__row {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .facts__row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }
  .support-list {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .support-list__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    align-items: start;
  }
  .support-list__item--off {
    color: var(--muted);
  }
  .support-list__icon {
    display: flex;
    margin-top: 0.1rem;
  }
  .support-list__label {
    display: block;
    font-weight: 600;
  }
  .support-list__note {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .chip--tag {
    color: var(--muted);
  }
  .facts__play {
    width: 100%;
    margin-top: var(--space-4);
  }
  .game__ad {
    margin-top: var(--space-6);
  }
</style>
