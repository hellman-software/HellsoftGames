---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getListedGames, formatDate, paragraphs, repoUrl } from '../../lib/games';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const games = await getListedGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { title, genre, blurb, description, status, playUrl, tech, tags, cover, logo, screenshots, pixelArt, sync } =
  game.data;
const repo = repoUrl(game);
const release = sync?.release ?? null;
const releaseDate = formatDate(release?.publishedAt);
const updated = formatDate(sync?.pushedAt);
const body = paragraphs(description || sync?.description || '');
const hero = cover ?? screenshots[0]?.src ?? null;
const gallery = screenshots.filter((s) => s.src !== hero);
---

<Base title={title} description={blurb} image={hero ? hero.src : undefined}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a class="label" href={withBase('/') + '#games'}>&lt;&lt; All games</a>
  </nav>

  <article class="game">
    <header class="game__header">
      <div class="game__meta">
        <StatusBadge status={status} />
        <span class="label muted">{genre}</span>
      </div>
      <h1 class="game__title">{title}</h1>
      <p class="game__blurb">{blurb}</p>
      <div class="game__actions">
        <a class="btn" href={playUrl} target="_blank" rel="noopener">Play now ▶</a>
        {repo && (
          <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener">
            Source
          </a>
        )}
      </div>
    </header>

    <div class="game__hero pixel-box">
      {
        hero ? (
          <Image src={hero} alt={screenshots[0]?.alt ?? `${title} screenshot`} width={1280} height={720} class:list={['game__hero-img', { pixelated: pixelArt }]} loading="eager" />
        ) : logo ? (
          <div class="game__logo-wrap">
            <Image src={logo} alt={`${title} logo`} width={320} height={320} class="game__logo" loading="eager" />
          </div>
        ) : (
          <div class="game__placeholder pixel">{title}</div>
        )
      }
    </div>

    <div class="game__layout">
      <section class="game__about" aria-labelledby="about-heading">
        <h2 id="about-heading">About</h2>
        {body.map((p) => <p>{p}</p>)}

        {gallery.length > 0 && (
          <section aria-labelledby="shots-heading">
            <h2 id="shots-heading">Screenshots</h2>
            <ul class="gallery">
              {gallery.map((shot) => (
                <li class="pixel-box">
                  <Image src={shot.src} alt={shot.alt} width={800} height={450} class:list={['gallery__img', { pixelated: pixelArt }]} loading="lazy" />
                </li>
              ))}
            </ul>
          </section>
        )}
      </section>

      <aside class="game__facts pixel-box" aria-label="Game facts">
        <dl class="facts">
          <dt class="label">Status</dt>
          <dd><StatusBadge status={status} /></dd>
          {release && (
            <>
              <dt class="label">Version</dt>
              <dd>
                {release.tag}
                {releaseDate && <span class="muted"> · {releaseDate}</span>}
              </dd>
            </>
          )}
          {updated && (
            <>
              <dt class="label">Updated</dt>
              <dd>{updated}</dd>
            </>
          )}
          <dt class="label">Platform</dt>
          <dd>Web browser</dd>
          <dt class="label">Built with</dt>
          <dd>
            <ul class="chips">
              {tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </dd>
          {tags.length > 0 && (
            <>
              <dt class="label">Tags</dt>
              <dd>
                <ul class="chips">
                  {tags.map((t) => (
                    <li class="chip">#{t}</li>
                  ))}
                </ul>
              </dd>
            </>
          )}
          {repo && (
            <>
              <dt class="label">Source</dt>
              <dd><a href={repo} rel="noopener">{game.data.repo.owner}/{game.data.repo.name}</a></dd>
            </>
          )}
        </dl>
        <a class="btn facts__play" href={playUrl} target="_blank" rel="noopener">Play now ▶</a>
      </aside>
    </div>

    <AdSlot id="game-bottom" size="rectangle" class="game__ad" />
  </article>
</Base>

<style>
  .crumbs {
    margin-bottom: var(--space-4);
  }
  .crumbs a {
    text-decoration: none;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .game__header {
    margin-bottom: var(--space-4);
  }
  .game__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .game__title {
    text-shadow:
      2px 0 var(--magenta),
      -2px 0 var(--cyan);
  }
  .game__blurb {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 48rem;
  }
  .game__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .game__hero {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: var(--space-5);
    background: var(--bg-2);
  }
  .game__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .game__logo-wrap {
    display: grid;
    place-items: center;
    height: 100%;
    background:
      radial-gradient(circle at 50% 60%, var(--glow), transparent 60%),
      repeating-linear-gradient(90deg, transparent 0 23px, var(--border) 23px 24px),
      repeating-linear-gradient(0deg, transparent 0 23px, var(--border) 23px 24px);
  }
  .game__logo {
    width: 35%;
    height: auto;
  }
  .game__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--accent);
  }
  .game__layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (max-width: 760px) {
    .game__layout {
      grid-template-columns: 1fr;
    }
  }
  .game__about p {
    max-width: 65ch;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
  }
  .gallery__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .game__facts {
    padding: var(--space-3);
    position: sticky;
    top: calc(64px + var(--space-3));
  }
  .facts {
    margin: 0;
    display: grid;
    gap: var(--space-1) var(--space-3);
  }
  .facts dt {
    color: var(--muted);
    margin-top: var(--space-2);
  }
  .facts dd {
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }
  .facts__play {
    width: 100%;
    margin-top: var(--space-4);
  }
  .game__ad {
    margin-top: var(--space-6);
  }
</style>
