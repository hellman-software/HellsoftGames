---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getListedGames } from '../lib/games';

const games = await getListedGames();
const [featured, ...rest] = games;
const AD_AFTER = 3;
---

<Base
  title="Hellsoft Games"
  description="Games by Erik Hellman (Hellsoft): action-adventures, dungeon crawlers, car-theft sandboxes and AI-driven worlds. Explore the games and find your next favourite."
>
  <section id="games" aria-labelledby="games-heading" class="catalogue">
    <header class="catalogue__header">
      <h1 id="games-heading" class="catalogue__title">Games</h1>
      <p class="catalogue__count">{games.length} games to explore</p>
    </header>

    {
      featured && (
        <div class="featured">
          <GameCard game={featured} featured />
        </div>
      )
    }

    <div class="home-ad">
      <AdSlot id="home-leaderboard" size="leaderboard" />
    </div>

    <ul class="grid">
      {
        rest.map((game, i) => (
          <>
            <li class="reveal" style={`--i: ${i}`}>
              <GameCard game={game} />
            </li>
            {i + 1 === AD_AFTER && (
              <li class="grid__ad reveal" style={`--i: ${i + 1}`}>
                <AdSlot id="home-feed-1" size="card" />
              </li>
            )}
          </>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .catalogue {
    scroll-margin-top: calc(var(--header-h) + var(--space-3));
  }
  .catalogue__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
  }
  .catalogue__title {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    letter-spacing: -0.025em;
  }
  .catalogue__count {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .home-ad {
    padding-block: clamp(var(--space-4), 4vw, var(--space-5));
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
  }
  .grid > li {
    min-width: 0;
  }
</style>
