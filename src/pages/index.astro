---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getListedGames } from '../lib/games';

const games = await getListedGames();
const [featured, ...rest] = games;
const AD_AFTER = 3;
---

<Base
  title="Hellsoft Games"
  description="Browser games by Erik Hellman (Hellsoft): action-adventures, dungeon crawlers, car-theft sandboxes and AI-driven worlds. Play them free in your browser."
>
  <section class="hero">
    <p class="hero__kicker label reveal" style="--i: 0">
      <span class="hero__pulse" aria-hidden="true"></span>
      {games.length} games · all playable in your browser
    </p>
    <h1 class="hero__title reveal" style="--i: 1">
      One click in.<br />
      <span class="gradient-text">Hours deep.</span>
    </h1>
    <p class="hero__tagline reveal" style="--i: 2">
      No installs, no sign-ups (unless a game needs one). From kart races to dungeon dives, pick one and play.
    </p>
    <div class="hero__actions reveal" style="--i: 3">
      <a class="btn" href="#games">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        Browse games
      </a>
      <a class="btn btn--ghost" href="https://github.com/ErikHellman" rel="noopener">GitHub</a>
    </div>
  </section>

  <AdSlot id="home-leaderboard" size="leaderboard" class="home-ad" />

  <section id="games" aria-labelledby="games-heading" class="catalogue">
    <h2 id="games-heading" class="visually-hidden">All games</h2>

    {
      featured && (
        <div class="featured reveal" style="--i: 4">
          <GameCard game={featured} featured />
        </div>
      )
    }

    <ul class="grid">
      {
        rest.map((game, i) => (
          <>
            <li class="reveal" style={`--i: ${5 + i}`}>
              <GameCard game={game} />
            </li>
            {i + 1 === AD_AFTER && (
              <li class="grid__ad reveal" style={`--i: ${6 + i}`}>
                <AdSlot id="home-feed-1" size="card" />
              </li>
            )}
          </>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
    max-width: 52rem;
  }
  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--text-2);
    margin: 0 0 var(--space-4);
    padding: 0.5em 0.9em 0.5em 0.7em;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .hero__pulse {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--lime) 55%, transparent);
    animation: pulse 2.2s var(--ease) infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .hero__title {
    margin-bottom: var(--space-4);
  }
  .hero__tagline {
    max-width: 36rem;
    color: var(--text-2);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    margin-bottom: var(--space-4);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .home-ad {
    margin-block: 0 var(--space-5);
  }
  .featured {
    margin-bottom: var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
  }
  .grid > li {
    min-width: 0;
  }
</style>
