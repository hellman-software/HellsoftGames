---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getListedGames } from '../lib/games';

const games = await getListedGames();
const AD_AFTER = 4;
---

<Base
  title="Hellsoft Games"
  description="Browser games by Erik Hellman (Hellsoft): action-adventures, dungeon crawlers, car-theft sandboxes and AI-driven worlds. Play them free in your browser."
>
  <section class="hero">
    <p class="hero__kicker label">Press start</p>
    <h1 class="hero__title">HELLSOFT GAMES</h1>
    <p class="hero__tagline">
      Games I build for the browser. No installs, no accounts unless the game says so. Pick one and play.
    </p>
  </section>

  <AdSlot id="home-leaderboard" size="leaderboard" class="home-ad" />

  <section id="games" aria-labelledby="games-heading">
    <h2 id="games-heading" class="section-title">
      <span class="section-title__arrow" aria-hidden="true">▶</span> Select game
      <span class="section-title__count muted">[{games.length}]</span>
    </h2>
    <ul class="grid">
      {
        games.map((game, i) => (
          <>
            <li>
              <GameCard game={game} />
            </li>
            {i + 1 === AD_AFTER && (
              <li class="grid__ad">
                <AdSlot id="home-feed-1" size="card" />
              </li>
            )}
          </>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding-block: var(--space-5) var(--space-4);
  }
  .hero__kicker {
    color: var(--accent-2);
    margin: 0 0 var(--space-3);
    animation: blink 1.2s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .hero__title {
    font-size: clamp(1.4rem, 6vw, 3rem);
    color: var(--text);
    text-shadow:
      3px 0 var(--magenta),
      -3px 0 var(--cyan);
    margin-bottom: var(--space-3);
  }
  .hero__tagline {
    max-width: 38rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .home-ad {
    margin-block: var(--space-4) var(--space-5);
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .section-title__arrow {
    color: var(--accent);
  }
  .section-title__count {
    font-size: 0.7em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
  }
  .grid > li {
    min-width: 0;
  }
</style>
