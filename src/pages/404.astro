---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title="404" description="Page not found.">
  <section class="lost">
    <p class="label muted">Error 404</p>
    <h1 class="lost__title">GAME OVER</h1>
    <p class="muted">That level does not exist. Perhaps it was never built, or the cartridge needs a blow.</p>
    <a class="btn" href={withBase('/')}>Continue? ▶</a>
  </section>
</Base>

<style>
  .lost {
    text-align: center;
    padding-block: var(--space-6);
  }
  .lost__title {
    font-size: clamp(1.4rem, 6vw, 3rem);
    color: var(--magenta);
    text-shadow: 4px 4px 0 var(--shadow);
  }
</style>
